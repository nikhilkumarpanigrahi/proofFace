# ProofFace Environment Configuration Template

# Search Provider Configuration
# Supported providers: serpapi, brave, tavily, google, public_web
SEARCH_PROVIDER=public_web
SEARCH_API_KEY=

# Secondary Search Provider (Optional for fallback)
SEARCH_FALLBACK_PROVIDER=public_web
SEARCH_FALLBACK_API_KEY=

# Search & Candidate Processing Tuning
SEARCH_TIMEOUT_MS=6000
MAX_SEARCH_RESULTS=10
MAX_CONCURRENT_CANDIDATES=5
CANDIDATE_TIMEOUT_MS=8000
MAX_RETRIES=2

# Face Matching Thresholds (0.0 to 1.0)
HIGH_CONFIDENCE_THRESHOLD=0.75
POSSIBLE_MATCH_THRESHOLD=0.55

# Blockchain Configuration (Polygon Amoy Testnet)
# Chain ID 80002
CHAIN_ID=80002
RPC_PRIMARY=https://rpc-amoy.polygon.technology
RPC_SECONDARY=https://polygon-amoy.drpc.org

# Wallet & Contract (Optional for dry-run/local test, required for live testnet write)
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=

# Observability
RUST_LOG=info
